# Streamlit の Secrets 設定の雛形。
#
# 【クラウド(Streamlit Community Cloud)の場合】
#   このファイルは使いません。デプロイ画面の「Advanced settings → Secrets」欄に
#   下の1行(引用符つき)を貼り付けてください。
#
# 【ローカルで secrets を使ってみたい場合】
#   このファイルを同じフォルダに secrets.toml という名前でコピーし、値を入れてください。
#   (secrets.toml は .gitignore 済みなので公開されません)

GOOGLE_PLACES_API_KEY = "ここにあなたのAPIキー(AIzaSy...)"
